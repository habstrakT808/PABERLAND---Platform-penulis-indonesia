@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

actor Pengguna as User
boundary HalamanDetailArtikelUI as ArtikelUI
control KomentarController as Controller
entity KomentarProvider as Komentar

== Main Flow ==

User -> ArtikelUI : 1: Buka halaman detail artikel
activate ArtikelUI
ArtikelUI --> User : 1.1: Tampilkan form komentar

User -> ArtikelUI : 2: Ketik komentar pada form komentar
User -> ArtikelUI : 3: Klik tombol "Kirim"
ArtikelUI -> Controller : 3.1: tambahKomentar(artikelId, komentar)
activate Controller

alt [Komentar tidak kosong]
    Controller -> Komentar : 3.1.1: simpanKomentar(artikelId, komentar)
    activate Komentar
    Komentar --> Controller : 3.1.2: Komentar berhasil disimpan
    Controller --> ArtikelUI : 3.1.3: Komentar berhasil ditambahkan
    ArtikelUI --> User : 3.1.4: Tampilkan komentar di halaman artikel
    deactivate Komentar
else [Komentar kosong]
    Controller --> ArtikelUI : 3.1.1a: Error validasi
    ArtikelUI --> User : 3.1.2a: Pesan validasi
end

deactivate Controller
deactivate ArtikelUI

@enduml
