@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

actor Pengguna as User
boundary HalamanProfilUI as ProfilUI
boundary ModalKonfirmasiUI as ModalUI
control LogoutController as Controller

== Main Flow ==

User -> ProfilUI : 1: Klik tombol Logout di menu profil atau navigasi
activate ProfilUI

alt [Sistem menggunakan konfirmasi]
    ProfilUI -> ModalUI : 1.1: tampilkan()
    activate ModalUI
    ModalUI --> User : 1.1.1: Konfirmasi logout
    User -> ModalUI : 2: Konfirmasi logout
    ModalUI -> Controller : 2.1: logout()
    activate Controller
    Controller --> ModalUI : 2.1.1: Logout berhasil
    ModalUI --> ProfilUI : 2.1.2: Logout berhasil
    ProfilUI --> User : 2.1.3: Redirect ke halaman beranda
    ProfilUI --> User : 2.1.4: Notifikasi "Anda telah logout"
    deactivate Controller
    deactivate ModalUI
else [Sistem tidak menggunakan konfirmasi]
    ProfilUI -> Controller : 1.1: logout()
    activate Controller
    Controller --> ProfilUI : 1.1.1: Logout berhasil
    ProfilUI --> User : 1.1.2: Redirect ke halaman beranda
    ProfilUI --> User : 1.1.3: Notifikasi "Anda telah logout"
    deactivate Controller
end

deactivate ProfilUI

@enduml
