@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

actor Administrator as User
boundary HalamanKelolaPenggunaUI as KelolaUI
boundary ModalKonfirmasiUI as ModalUI
control UserController as Controller
entity UserProvider as UserData

== Main Flow ==

User -> KelolaUI : 1: Buka halaman kelola pengguna
activate KelolaUI
KelolaUI -> Controller : 1.1: muatDaftarPengguna()
activate Controller
Controller -> UserData : 1.1.1: ambilSemuaPengguna()
activate UserData
UserData --> Controller : 1.1.2: Daftar pengguna
Controller --> KelolaUI : 1.1.3: Data pengguna
KelolaUI --> User : 1.1.4: Tampilkan tabel pengguna\n(filter, pencarian, opsi aksi)

alt [Administrator mengubah role]
    User -> KelolaUI : 2: Klik Edit Role
    KelolaUI -> ModalUI : 2.1: tampilkan()
    activate ModalUI
    ModalUI --> User : 2.1.1: Modal konfirmasi
    User -> ModalUI : 2.2: Konfirmasi perubahan role
    ModalUI -> Controller : 2.2.1: ubahRole(userId, roleBaru)
    Controller -> UserData : 2.2.2: updateRole(userId, roleBaru)
    UserData --> Controller : 2.2.3: Role berhasil diubah
    Controller --> KelolaUI : 2.2.4: Perubahan berhasil
    KelolaUI --> User : 2.2.5: Notifikasi sukses
    deactivate ModalUI
else [Administrator melakukan ban atau unban]
    User -> KelolaUI : 2a: Klik Ban atau Unban
    KelolaUI -> Controller : 2a.1: toggleBan(userId)
    Controller -> UserData : 2a.1.1: updateStatusBan(userId)
    UserData --> Controller : 2a.1.2: Status ban berhasil diubah
    Controller --> KelolaUI : 2a.1.3: Status berhasil diubah
    KelolaUI --> User : 2a.1.4: Notifikasi sukses
end

deactivate UserData
deactivate Controller
deactivate KelolaUI

@enduml
